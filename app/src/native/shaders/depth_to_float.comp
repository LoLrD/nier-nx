#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depth_source;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D destination;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D destination_raw;

layout(push_constant) uniform Constants {
  ivec2 source_offset;
  ivec2 dest_offset;
  ivec2 size;
  ivec2 scale;
  int write_raw;
} constants;

void main() {
  ivec2 position = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(position, constants.size))) {
    return;
  }
  float depth = texelFetch(depth_source, constants.source_offset + position * constants.scale, 0).r;
  imageStore(destination, constants.dest_offset + position, vec4(depth));
  if (constants.write_raw != 0) {
    uint bits = uint(clamp(depth, 0.0, 1.0) * 16777215.0 + 0.5) << 8;
    imageStore(destination_raw, constants.dest_offset + position,
               vec4(uvec4(bits, bits >> 8, bits >> 16, bits >> 24) & 0xFFu) / 255.0);
  }
}
